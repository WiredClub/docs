{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "id": "wired-club-docs",
  "name": "Wired Club Docs",
  "short_name": "WC Docs",
  "description": "Documentação oficial da comunidade Wired Club, o maior portal Wired!",
  "orientation": "portrait-primary",
  "display": "standalone",
  "start_url": "/?utm_source=web_app_manifest",
  "scope": "/",
  "theme_color": "#0b1530",
  "background_color": "#0b1530",
  "icons": [
    {
      "src": "/pwa-64x64.png",
      "sizes": "64x64",
      "type": "image/png"
    },
    {
      "src": "/pwa-192x192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/pwa-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/maskable-icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Vamos Começar",
      "url": "/vamos-comecar/introducao",
      "description": "Guias iniciais do Wired Club Docs"
    },
    {
      "name": "Guias Práticos",
      "url": "/guias-praticos/primeiro-sistema/",
      "description": "Tutoriais e guias práticos"
    }
  ]
}
