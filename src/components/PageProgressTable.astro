---
import { getCollection } from 'astro:content';
import { getPageContributors } from 'starlight-recent-changes/activity';
import { getPageStatus, getCategoryLabel, STATUS_MAP, type DocPageStatus } from '../utils/pageProgress';

const allDocs = await getCollection('docs', ({ id, data }) => {
	return id !== 'index' && data.template !== 'splash';
});

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const dateFormat = new Intl.DateTimeFormat('pt-BR', {
	day: '2-digit',
	month: '2-digit',
	year: 'numeric',
	timeZone: 'America/Sao_Paulo',
});
const fullDateFormat = new Intl.DateTimeFormat('pt-BR', {
	day: 'numeric',
	month: 'long',
	year: 'numeric',
	timeZone: 'America/Sao_Paulo',
});

const pages = allDocs.map((entry) => {
	const status: DocPageStatus = getPageStatus(entry.data);
	const contributors = entry.filePath ? getPageContributors(entry.filePath) : [];
	const validContributors = contributors.filter((c) => c.name);

	const lastModifiedIso = validContributors[0]?.lastContributedAt ?? '';
	const lastModifiedDate = lastModifiedIso ? new Date(lastModifiedIso) : null;
	const isValidDate = lastModifiedDate && !Number.isNaN(lastModifiedDate.getTime());

	const formattedDate = isValidDate ? dateFormat.format(lastModifiedDate) : '—';
	const fullDate = isValidDate ? fullDateFormat.format(lastModifiedDate) : '';
	const timestamp = isValidDate ? lastModifiedDate.getTime() : 0;

	const rawUrl = `${base}/${entry.id}/`.replace(/\/+/g, '/');
	const category = getCategoryLabel(entry.id);

	return {
		id: entry.id,
		title: entry.data.title || entry.id,
		url: rawUrl,
		status,
		category,
		contributors: validContributors,
		lastModifiedIso,
		formattedDate,
		fullDate,
		timestamp,
	};
});

// Sort by category then title by default
pages.sort((a, b) => a.category.localeCompare(b.category, 'pt-BR') || a.title.localeCompare(b.title, 'pt-BR'));

const totalPages = pages.length;
const counts = {
	consolidado: pages.filter((p) => p.status === 'consolidado').length,
	novo: pages.filter((p) => p.status === 'novo').length,
	rascunho: pages.filter((p) => p.status === 'rascunho').length,
};

const percentages = {
	consolidado: totalPages ? ((counts.consolidado / totalPages) * 100).toFixed(1) : '0',
	novo: totalPages ? ((counts.novo / totalPages) * 100).toFixed(1) : '0',
	rascunho: totalPages ? ((counts.rascunho / totalPages) * 100).toFixed(1) : '0',
};

const uniqueCategories = [...new Set(pages.map((p) => p.category))].sort((a, b) => a.localeCompare(b, 'pt-BR'));
---

<section class="doc-progress not-content" aria-label="Progresso por página da documentação" data-pagefind-ignore>
	<div class="progress-summary-card">
		<div class="summary-top">
			<div class="summary-heading">
				<span class="summary-eyebrow">Status da documentação</span>
				<div class="summary-counts">
					<span class="total-count"><strong>{totalPages}</strong> páginas documentadas</span>
				</div>
			</div>
			<!-- Multi-segment progress bar -->
			<div class="progress-bar-track" role="progressbar" aria-valuenow={counts.consolidado} aria-valuemin={0} aria-valuemax={totalPages} aria-label="Progresso das páginas consolidadas">
				<div
					class="progress-segment segment-consolidado"
					style={`width: ${percentages.consolidado}%;`}
					title={`Consolidado: ${counts.consolidado} páginas (${percentages.consolidado}%)`}
				></div>
				<div
					class="progress-segment segment-novo"
					style={`width: ${percentages.novo}%;`}
					title={`Novo: ${counts.novo} páginas (${percentages.novo}%)`}
				></div>
				<div
					class="progress-segment segment-rascunho"
					style={`width: ${percentages.rascunho}%;`}
					title={`Rascunho: ${counts.rascunho} páginas (${percentages.rascunho}%)`}
				></div>
			</div>
		</div>

		<!-- Status Filter Pills -->
		<div class="status-pills-list" role="tablist" aria-label="Filtrar por status">
			<button type="button" class="status-filter-btn active" data-status-filter="all" role="tab" aria-selected="true">
				<span class="pill-dot dot-all"></span>
				<span class="pill-label">Todas</span>
				<span class="pill-count">{totalPages}</span>
			</button>
			<button type="button" class="status-filter-btn" data-status-filter="consolidado" role="tab" aria-selected="false">
				<span class="pill-dot dot-consolidado"></span>
				<span class="pill-label">Consolidado</span>
				<span class="pill-count">{counts.consolidado}</span>
				<span class="pill-percent">({percentages.consolidado}%)</span>
			</button>
			<button type="button" class="status-filter-btn" data-status-filter="novo" role="tab" aria-selected="false">
				<span class="pill-dot dot-novo"></span>
				<span class="pill-label">Novo</span>
				<span class="pill-count">{counts.novo}</span>
				<span class="pill-percent">({percentages.novo}%)</span>
			</button>
			<button type="button" class="status-filter-btn" data-status-filter="rascunho" role="tab" aria-selected="false">
				<span class="pill-dot dot-rascunho"></span>
				<span class="pill-label">Rascunho</span>
				<span class="pill-count">{counts.rascunho}</span>
				<span class="pill-percent">({percentages.rascunho}%)</span>
			</button>
		</div>
	</div>

	<!-- Filter Controls -->
	<div class="table-controls">
		<div class="search-box">
			<svg class="search-icon" viewBox="0 0 20 20" width="16" height="16" fill="currentColor" aria-hidden="true">
				<path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.452 4.391l3.328 3.329a.75.75 0 11-1.06 1.06l-3.329-3.328A7 7 0 012 9z" clip-rule="evenodd" />
			</svg>
			<input
				type="search"
				id="page-search-input"
				class="search-input"
				placeholder="Buscar página por título..."
				autocomplete="off"
				aria-label="Buscar página por título"
			/>
		</div>

		<div class="category-filter-box">
			<label for="page-category-select" class="sr-only">Filtrar por categoria</label>
			<select id="page-category-select" class="category-select" aria-label="Filtrar por categoria">
				<option value="all">Todas as categorias ({totalPages})</option>
				{uniqueCategories.map((cat) => {
					const count = pages.filter((p) => p.category === cat).length;
					return <option value={cat}>{cat} ({count})</option>;
				})}
			</select>
		</div>

		<div class="results-feedback">
			<span>Mostrando <strong id="pages-visible-count">{totalPages}</strong> de {totalPages}</span>
		</div>
	</div>

	<!-- Table -->
	<div class="table-responsive" tabindex="0" role="region" aria-label="Tabela de progresso das páginas">
		<table class="progress-table">
			<thead>
				<tr>
					<th scope="col" class="th-sortable th-page" data-sort-key="title" aria-sort="none">
						<button type="button" class="th-btn">
							<span>Página</span>
							<span class="sort-indicator" aria-hidden="true">↕</span>
						</button>
					</th>
					<th scope="col" class="th-sortable th-status" data-sort-key="status" aria-sort="none">
						<button type="button" class="th-btn">
							<span>Status</span>
							<span class="sort-indicator" aria-hidden="true">↕</span>
						</button>
					</th>
					<th scope="col" class="th-sortable th-date" data-sort-key="date" aria-sort="none">
						<button type="button" class="th-btn">
							<span>Última alteração</span>
							<span class="sort-indicator" aria-hidden="true">↕</span>
						</button>
					</th>
					<th scope="col" class="th-contributors">
						<span>Contribuidores</span>
					</th>
				</tr>
			</thead>
			<tbody id="progress-tbody">
				{pages.map((page) => (
					<tr
						data-title={page.title.toLowerCase()}
						data-category={page.category}
						data-status={page.status}
						data-timestamp={page.timestamp}
					>
						<!-- Column 1: Page Link -->
						<td class="col-page">
							<a href={page.url} class="page-title-link">
								{page.title}
							</a>
							<span class="page-category-tag">{page.category}</span>
						</td>

						<!-- Column 2: Status Badge with Icon -->
						<td class="col-status">
							<span
								class:list={['status-badge', `status-${page.status}`]}
								title={STATUS_MAP[page.status].description}
							>
								{page.status === 'consolidado' && (
									<svg class="status-icon" viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true">
										<path d="M8 0a8 8 0 1 1 0 16A8 8 0 0 1 8 0zm3.41 5.41-4.7 4.7-2.12-2.12a.83.83 0 0 0-1.18 1.18l2.71 2.71a.83.83 0 0 0 1.18 0l5.29-5.29a.83.83 0 0 0-1.18-1.18z"/>
									</svg>
								)}
								{page.status === 'novo' && (
									<svg class="status-icon" viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true">
										<path d="M8 1.5l1.6 3.6 3.9.4-2.9 2.6.8 3.9L8 10.1l-3.4 1.9.8-3.9-2.9-2.6 3.9-.4L8 1.5z"/>
									</svg>
								)}
								{page.status === 'rascunho' && (
									<svg class="status-icon" viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true">
										<path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-9.5 9.5a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l9.5-9.5zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207 11.207 2.5zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293l6.5-6.5zm-9.761 5.175-.88 2.2 2.2-.88 5.441-5.441-1.32-1.32-5.441 5.441z"/>
									</svg>
								)}
								<span class="status-label">{STATUS_MAP[page.status].label}</span>
							</span>
						</td>

						<!-- Column 3: Last modified Date -->
						<td class="col-date">
							<time datetime={page.lastModifiedIso} title={page.fullDate || undefined} class="page-date">
								{page.formattedDate}
							</time>
						</td>

						<!-- Column 4: Contributors Avatar Stack -->
						<td class="col-contributors">
							{page.contributors.length > 0 ? (
								<div class="avatar-stack" aria-label={`Contribuidores: ${page.contributors.map((c) => c.name).join(', ')}`}>
									{page.contributors.map((person, idx) => (
										<a
											href={person.profileUrl || `https://github.com/${person.login || person.name}`}
											class="avatar-circle"
											style={`z-index: ${page.contributors.length - idx};`}
											title={`${person.name}${person.lastContributedAt ? ` (${dateFormat.format(new Date(person.lastContributedAt))})` : ''}`}
											aria-label={`Perfil de ${person.name} no GitHub`}
											target="_blank"
											rel="noopener noreferrer"
										>
											<span class="avatar-initials" aria-hidden="true">{person.name.slice(0, 2).toUpperCase()}</span>
											{person.avatarUrl && (
												<img
													src={person.avatarUrl}
													alt=""
													loading="lazy"
													width="28"
													height="28"
													onerror="this.style.display='none'"
												/>
											)}
										</a>
									))}
								</div>
							) : (
								<span class="no-contributors" title="Nenhum contribuidor registrado">—</span>
							)}
						</td>
					</tr>
				))}
			</tbody>
		</table>

		<!-- Empty search results message -->
		<div id="progress-empty" class="progress-empty-state" hidden>
			<p>Nenhuma página encontrada para os filtros selecionados.</p>
			<button type="button" id="btn-reset-filters" class="btn-reset">
				Limpar filtros
			</button>
		</div>
	</div>
</section>

<script>
	function initProgressTable() {
		const root = document.querySelector('.doc-progress');
		if (!root) return;

		const searchInput = root.querySelector<HTMLInputElement>('#page-search-input');
		const categorySelect = root.querySelector<HTMLSelectElement>('#page-category-select');
		const statusButtons = root.querySelectorAll<HTMLButtonElement>('.status-filter-btn');
		const tbody = root.querySelector<HTMLTableSectionElement>('#progress-tbody');
		const visibleCountEl = root.querySelector<HTMLElement>('#pages-visible-count');
		const emptyState = root.querySelector<HTMLElement>('#progress-empty');
		const resetBtn = root.querySelector<HTMLButtonElement>('#btn-reset-filters');
		const sortHeaders = root.querySelectorAll<HTMLTableCellElement>('th.th-sortable');

		if (!tbody) return;
		const rows = Array.from(tbody.querySelectorAll<HTMLTableRowElement>('tr'));

		let activeStatus = 'all';
		let currentSortKey: string | null = null;
		let currentSortOrder: 'asc' | 'desc' = 'asc';

		function filterRows() {
			const query = searchInput?.value.trim().toLowerCase() || '';
			const selectedCategory = categorySelect?.value || 'all';

			let visibleCount = 0;

			for (const row of rows) {
				const title = row.getAttribute('data-title') || '';
				const category = row.getAttribute('data-category') || '';
				const status = row.getAttribute('data-status') || '';

				const matchesQuery = !query || title.includes(query) || category.toLowerCase().includes(query);
				const matchesCategory = selectedCategory === 'all' || category === selectedCategory;
				const matchesStatus = activeStatus === 'all' || status === activeStatus;

				if (matchesQuery && matchesCategory && matchesStatus) {
					row.hidden = false;
					visibleCount++;
				} else {
					row.hidden = true;
				}
			}

			if (visibleCountEl) {
				visibleCountEl.textContent = String(visibleCount);
			}

			if (emptyState) {
				emptyState.hidden = visibleCount > 0;
			}
		}

		// Status filter buttons
		statusButtons.forEach((btn) => {
			btn.addEventListener('click', () => {
				statusButtons.forEach((b) => {
					b.classList.remove('active');
					b.setAttribute('aria-selected', 'false');
				});
				btn.classList.add('active');
				btn.setAttribute('aria-selected', 'true');
				activeStatus = btn.getAttribute('data-status-filter') || 'all';
				filterRows();
			});
		});

		// Search input listener
		searchInput?.addEventListener('input', () => {
			filterRows();
		});

		// Category select listener
		categorySelect?.addEventListener('change', () => {
			filterRows();
		});

		// Reset filters button
		resetBtn?.addEventListener('click', () => {
			if (searchInput) searchInput.value = '';
			if (categorySelect) categorySelect.value = 'all';
			activeStatus = 'all';
			statusButtons.forEach((b) => {
				const isAll = b.getAttribute('data-status-filter') === 'all';
				b.classList.toggle('active', isAll);
				b.setAttribute('aria-selected', isAll ? 'true' : 'false');
			});
			filterRows();
		});

		// Column sorting
		sortHeaders.forEach((th) => {
			th.addEventListener('click', () => {
				const sortKey = th.getAttribute('data-sort-key');
				if (!sortKey) return;

				if (currentSortKey === sortKey) {
					currentSortOrder = currentSortOrder === 'asc' ? 'desc' : 'asc';
				} else {
					currentSortKey = sortKey;
					// Dates default to most recent first on first click
					currentSortOrder = sortKey === 'date' ? 'desc' : 'asc';
				}

				// Update header indicators
				sortHeaders.forEach((otherTh) => {
					const otherIndicator = otherTh.querySelector('.sort-indicator');
					if (otherTh === th) {
						otherTh.setAttribute('aria-sort', currentSortOrder === 'asc' ? 'ascending' : 'descending');
						if (otherIndicator) {
							otherIndicator.textContent = currentSortOrder === 'asc' ? '▲' : '▼';
						}
					} else {
						otherTh.setAttribute('aria-sort', 'none');
						if (otherIndicator) otherIndicator.textContent = '↕';
					}
				});

				// Sort rows in DOM
				rows.sort((a, b) => {
					if (sortKey === 'title') {
						const titleA = a.getAttribute('data-title') || '';
						const titleB = b.getAttribute('data-title') || '';
						return currentSortOrder === 'asc'
							? titleA.localeCompare(titleB, 'pt-BR')
							: titleB.localeCompare(titleA, 'pt-BR');
					}
					if (sortKey === 'status') {
						const statusOrder: Record<string, number> = { consolidado: 1, novo: 2, rascunho: 3 };
						const valA = statusOrder[a.getAttribute('data-status') || ''] || 99;
						const valB = statusOrder[b.getAttribute('data-status') || ''] || 99;
						return currentSortOrder === 'asc' ? valA - valB : valB - valA;
					}
					if (sortKey === 'date') {
						const timeA = Number(a.getAttribute('data-timestamp')) || 0;
						const timeB = Number(b.getAttribute('data-timestamp')) || 0;
						return currentSortOrder === 'asc' ? timeA - timeB : timeB - timeA;
					}
					return 0;
				});

				for (const row of rows) {
					tbody.appendChild(row);
				}
			});
		});
	}

	// Run on initial load and view transitions
	initProgressTable();
	document.addEventListener('astro:page-load', initProgressTable);
</script>

<style>
	.doc-progress {
		margin-top: 2rem;
		margin-bottom: 3.5rem;
		font-size: var(--sl-text-base, 0.9rem);
	}

	/* Summary Card */
	.progress-summary-card {
		padding: 1.25rem 1.5rem;
		border-radius: var(--wc-radius-lg, 0.875rem);
		border: 1px solid var(--sl-color-hairline);
		background: linear-gradient(145deg, var(--sl-color-gray-6), var(--sl-color-bg));
		margin-bottom: 1.5rem;
		box-shadow: var(--wc-shadow);
	}

	.summary-top {
		margin-bottom: 1.25rem;
	}

	.summary-heading {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		margin-bottom: 0.75rem;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.summary-eyebrow {
		font-size: 0.75rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--sl-color-accent);
	}

	.summary-counts {
		font-size: 0.85rem;
		color: var(--sl-color-gray-2);
	}

	.summary-counts strong {
		color: var(--sl-color-white);
		font-size: 1.1rem;
	}

	/* Progress Bar */
	.progress-bar-track {
		display: flex;
		height: 0.65rem;
		width: 100%;
		border-radius: 999px;
		overflow: hidden;
		background: var(--sl-color-gray-5);
		border: 1px solid var(--sl-color-hairline);
	}

	.progress-segment {
		height: 100%;
		transition: width 0.3s ease;
	}

	.segment-consolidado {
		background: var(--sl-color-green, #25d886);
	}

	.segment-novo {
		background: var(--sl-color-blue, #2aa9ff);
	}

	.segment-rascunho {
		background: var(--sl-color-orange, #ff9c27);
	}

	/* Status Pills Filter */
	.status-pills-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		align-items: center;
	}

	.status-filter-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.45rem;
		height: 2.25rem;
		min-height: 2.25rem;
		max-height: 2.25rem;
		box-sizing: border-box;
		padding: 0 0.85rem;
		border-radius: 999px;
		border: 1px solid var(--sl-color-hairline);
		background: var(--sl-color-gray-6);
		color: var(--sl-color-gray-2);
		font-size: 0.8rem;
		line-height: 1;
		font-family: inherit;
		cursor: pointer;
		transition: all 0.15s ease;
		user-select: none;
		vertical-align: middle;
	}

	.status-filter-btn:hover {
		border-color: var(--sl-color-accent);
		color: var(--sl-color-white);
		background: var(--sl-color-gray-5);
	}

	.status-filter-btn.active {
		background: var(--sl-color-accent-low);
		border-color: var(--sl-color-accent);
		color: var(--sl-color-white);
		font-weight: 600;
	}

	.pill-dot {
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		flex-shrink: 0;
	}

	.dot-all {
		background: var(--sl-color-gray-3);
	}

	.dot-consolidado {
		background: var(--sl-color-green, #25d886);
	}

	.dot-novo {
		background: var(--sl-color-blue, #2aa9ff);
	}

	.dot-rascunho {
		background: var(--sl-color-orange, #ff9c27);
	}

	.pill-label {
		line-height: 1;
	}

	.pill-count {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		height: 1.25rem;
		padding: 0 0.45rem;
		border-radius: 999px;
		background: var(--sl-color-gray-5);
		font-size: 0.72rem;
		font-weight: 600;
		line-height: 1;
		box-sizing: border-box;
	}

	.status-filter-btn.active .pill-count {
		background: var(--sl-color-accent);
		color: var(--sl-color-text-invert, #030712);
	}

	.pill-percent {
		font-size: 0.72rem;
		color: var(--sl-color-gray-3);
		line-height: 1;
	}

	.status-filter-btn.active .pill-percent {
		color: var(--sl-color-accent-high);
	}

	/* Controls Bar - Perfectly Aligned Horizontally */
	.table-controls {
		display: flex;
		align-items: center;
		justify-content: flex-start;
		gap: 0.85rem;
		margin-bottom: 1.25rem;
		width: 100%;
		box-sizing: border-box;
	}

	.search-box {
		position: relative;
		flex: 1 1 18rem;
		min-width: 13rem;
		display: flex;
		align-items: center;
	}

	.search-icon {
		position: absolute;
		left: 0.85rem;
		top: 50%;
